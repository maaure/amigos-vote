{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubdomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}

	# WebSocket / Socket.io (tempo real)
	@tribunal-socket path /tribunal-do-dia/socket.io*
	handle @tribunal-socket {
		reverse_proxy socket:3001
	}

	# Tribunal do Dia (app Next)
	@tribunal path /tribunal-do-dia /tribunal-do-dia/*
	handle @tribunal {
		reverse_proxy next-app:3000
	}

	# Raiz do domínio
	handle {
		respond "maaure.fun" 200
	}
}
